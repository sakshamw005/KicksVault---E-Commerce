<% layout('layouts/boilerplate') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<div class="min-h-[60vh] flex items-center justify-center px-4">
  <div class="w-full max-w-md rounded-lg border border-gray-800 bg-kvsurface p-6">
    <h1 class="text-2xl font-semibold mb-4">Reset Password</h1>
    <form action="/reset/<%= token %>" method="POST" class="space-y-3">
      <div>
        <label for="password" class="block text-sm text-gray-300">New Password</label>
        <input type="password" name="password" id="password" placeholder="Enter new password" class="mt-1 w-full px-3 py-2 rounded-md bg-[#0b0d11] border border-gray-700 text-sm text-gray-200" />
      </div>
      <button type="submit" class="w-full px-3 py-2 bg-gradient-to-r from-kvprimary to-emerald-400 text-black rounded-md">Update password</button>
    </form>
    <p class="text-sm text-gray-400 mt-3">Back to <a href="/login" class="text-emerald-400">Login</a></p>
  </div>
</div>