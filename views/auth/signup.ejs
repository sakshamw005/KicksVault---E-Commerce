<% layout('layouts/boilerplate') %>

<div class="min-h-[70vh] flex items-center justify-center px-4">
  <div class="w-full max-w-md rounded-lg border border-gray-800 bg-kvsurface p-6">
    <%- include('../partials/flash') %>
    <h1 class="text-2xl font-semibold mb-4">Join KicksVault</h1>
    <form action="/register" method="POST" class="space-y-3">
      <div>
        <label for="username" class="block text-sm text-gray-300">Username</label>
        <input type="text" name="username" id="username" placeholder="Username" class="mt-1 w-full px-3 py-2 rounded-md bg-[#0b0d11] border border-gray-700 text-sm text-gray-200" />
      </div>
      <div>
        <label for="email" class="block text-sm text-gray-300">Email</label>
        <input type="email" name="email" id="email" placeholder="Email" class="mt-1 w-full px-3 py-2 rounded-md bg-[#0b0d11] border border-gray-700 text-sm text-gray-200" />
      </div>
      <div>
        <label for="password" class="block text-sm text-gray-300">Password</label>
        <input type="password" name="password" id="password" placeholder="Password" class="mt-1 w-full px-3 py-2 rounded-md bg-[#0b0d11] border border-gray-700 text-sm text-gray-200" />
      </div>
      <button type="submit" class="w-full px-3 py-2 bg-gradient-to-r from-kvprimary to-emerald-400 text-black rounded-md">Sign Up</button>
    </form>
    <p class="text-sm text-gray-400 mt-3">Already have an account? <a href="/login" class="text-emerald-400">Login</a></p>
  </div>
</div>
