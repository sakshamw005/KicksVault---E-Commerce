<% layout('layouts/boilerplate') %>
<%- include('partials/navbar') %>
<%- include('partials/flash') %>

<div class="max-w-6xl mx-auto px-4 my-6">
  <h2 class="text-2xl font-semibold mb-3">Your Cart</h2>
  <% if(items && items.length){ %>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% items.forEach(({product, qty, color})=>{ %>
        <div class="rounded-lg border border-gray-800 bg-kvsurface overflow-hidden">
          <img src="<%=product.img%>" alt="<%=product.name%>" class="w-full h-48 object-cover" />
          <div class="p-4">
            <h5 class="text-lg font-medium"><%=product.name%></h5>
            <p class="text-gray-400 text-sm">Color: <%=color || 'Default'%></p>
            <p class="text-kvprimary font-semibold">₹<%=product.price%> × <%=qty%></p>
            <form action="/cart/remove/<%=product._id%>/<%=encodeURIComponent(color || 'Default')%>" method="POST" class="mt-2">
              <button class="px-3 py-2 border border-red-600 text-red-400 rounded-md text-sm">Remove</button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
    <div class="mt-4 flex items-center justify-between">
      <h4 class="text-xl font-semibold">Total: ₹<%=total%></h4>
      <form action="/checkout" method="POST">
        <button class="px-4 py-2 bg-gradient-to-r from-kvprimary to-emerald-400 text-black rounded-md">Proceed to Checkout</button>
      </form>
    </div>
  <% } else { %>
    <div class="rounded-md border border-gray-700 bg-kvsurface text-gray-300 px-4 py-3">Your cart is empty.</div>
  <% } %>
</div>