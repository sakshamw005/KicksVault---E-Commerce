<% layout('layouts/boilerplate') %>
<%- include('partials/navbar') %>
<%- include('partials/flash') %>

<section class="relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 py-10">
    <div class="grid lg:grid-cols-2 gap-8 items-center">
      <div>
        <h1 class="text-5xl font-bold leading-tight">KicksVault</h1>
        <p class="mt-4 text-gray-300 text-lg">Premium sneakers, fast navigation, and a clean, secure shopping experience built for speed and style.</p>
        <div class="mt-6 flex items-center gap-4">
          <a href="/products" class="px-5 py-3 bg-gradient-to-r from-kvprimary to-emerald-400 text-black rounded-md">Shop Sneakers</a>
          <% if (currentUser && currentUser.role === 'admin') { %>
            <a href="/product/new" class="px-5 py-3 border border-gray-700 text-gray-300 rounded-md">Add Product</a>
          <% } %>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div class="aspect-[3/4] rounded-lg overflow-hidden border border-gray-800">
          <img class="w-full h-full object-cover" src="/img/S1.jpg" alt="Sneaker 1" loading="lazy" />
        </div>
        <div class="aspect-[3/4] rounded-lg overflow-hidden border border-gray-800">
          <img class="w-full h-full object-cover" src="/img/S2.jpg" alt="Sneaker 2" loading="lazy" />
        </div>
        <div class="aspect-[3/4] rounded-lg overflow-hidden border border-gray-800">
          <img class="w-full h-full object-cover" src="/img/S3.jpg" alt="Sneaker 3" loading="lazy" />
        </div>
        <div class="aspect-[3/4] rounded-lg overflow-hidden border border-gray-800">
          <img class="w-full h-full object-cover" src="/img/S4.jpg" alt="Sneaker 4" loading="lazy" />
        </div>
      </div>
    </div>
  </div>
</section>

<section class="max-w-6xl mx-auto px-4 pb-10">
  <div class="p-8 rounded-lg border border-gray-800 bg-gradient-to-br from-kvaccent/20 to-kvprimary/10 kv-hero-pattern">
    <h2 class="text-2xl font-semibold">Why KicksVault?</h2>
    <ul class="mt-3 grid sm:grid-cols-2 lg:grid-cols-3 gap-3 text-sm text-gray-300">
      <li class="rounded-md border border-gray-800 bg-kvsurface p-3">Curated premium sneakers</li>
      <li class="rounded-md border border-gray-800 bg-kvsurface p-3">Fast search and navigation</li>
      <li class="rounded-md border border-gray-800 bg-kvsurface p-3">Secure authentication</li>
      <li class="rounded-md border border-gray-800 bg-kvsurface p-3">Session-based cart</li>
      <li class="rounded-md border border-gray-800 bg-kvsurface p-3">Admin inventory tools</li>
      <li class="rounded-md border border-gray-800 bg-kvsurface p-3">Order monitoring</li>
    </ul>
  </div>
</section>