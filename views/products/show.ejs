<% layout('layouts/boilerplate') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<div class="max-w-6xl mx-auto px-4 py-6 grid lg:grid-cols-3 gap-8">
  <div class="lg:col-span-2 rounded-lg border border-gray-800 bg-kvsurface overflow-hidden">
    <img src="<%=foundProduct.img%>" alt="<%=foundProduct.name%>" class="w-full h-96 object-cover" />
    <div class="p-6">
      <h2 class="text-2xl font-semibold"><%=foundProduct.name%></h2>
      <p class="text-kvprimary text-xl font-semibold mt-2">₹<%=foundProduct.price%></p>
      <p class="text-gray-300 mt-3"><%=foundProduct.desc%></p>
      <div class="mt-4 flex items-center gap-3">
        <% if (currentUser && currentUser.role === 'admin') { %>
          <a href="/products/<%=foundProduct._id%>/edit" class="px-3 py-2 border border-gray-700 text-gray-300 rounded-md text-sm">Edit</a>
        <% } %>
        <form action="/cart/add/<%=foundProduct._id%>" method="POST" class="flex items-center gap-2">
          <select name="color" class="px-2 py-2 rounded-md bg-[#0b0d11] border border-gray-700 text-sm text-gray-200">
            <option value="Black">Black</option>
            <option value="White">White</option>
            <option value="Blue">Blue</option>
            <option value="Red">Red</option>
          </select>
          <input type="number" name="qty" min="1" value="1" class="w-20 px-2 py-2 rounded-md bg-[#0b0d11] border border-gray-700 text-sm text-gray-200" />
          <button class="px-3 py-2 bg-gradient-to-r from-kvprimary to-emerald-400 text-black rounded-md text-sm">Add to Cart</button>
        </form>
      </div>
    </div>
  </div>

  <div>
    <h3 class="text-xl font-semibold mb-3">Leave a review</h3>
    <form method="POST" action="/products/<%=foundProduct._id%>/review" class="rounded-lg border border-gray-800 bg-kvsurface p-4">
      <fieldset class="starability-basic">
        <input type="radio" id="rate5" name="rating" value="5" />
        <label for="rate5" title="Amazing">5 stars</label>
        <input type="radio" id="rate4" name="rating" value="4" />
        <label for="rate4" title="Very good">4 stars</label>
        <input type="radio" id="rate3" name="rating" value="3" />
        <label for="rate3" title="Average">3 stars</label>
        <input type="radio" id="rate2" name="rating" value="2" />
        <label for="rate2" title="Not good">2 stars</label>
        <input type="radio" id="rate1" name="rating" value="1" />
        <label for="rate1" title="Terrible">1 star</label>
        <span class="starability-focus-ring"></span>
      </fieldset>
      <label for="comment" class="block text-sm text-gray-300 mt-3">Comment</label>
      <textarea rows="3" name="comment" id="comment" class="mt-1 w-full px-3 py-2 rounded-md bg-[#0b0d11] border border-gray-700 text-sm text-gray-200"></textarea>
      <button class="mt-3 px-3 py-2 bg-emerald-500 text-black rounded-md text-sm">Add Review</button>
    </form>

    <div class="mt-4 space-y-3">
      <% for(let review of foundProduct.reviews){ %>
        <div class="rounded-lg border border-gray-800 bg-kvsurface p-4">
          <p class="text-xs text-gray-400">
            <% if(review.createdAt){ %>
              <%=review.createdAt.toDateString() %>
            <% } %>
          </p>
          <p class="starability-result" data-rating=<%=review.rating %>>Rated: <%=review.rating %></p>
          <p class="text-gray-300 mt-1"><%= review.comment %></p>
        </div>
      <% } %>
    </div>
  </div>
</div>